# Akasha 环境变量配置
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# ── LLM 配置（必填）──
AKASHA_LLM_PROVIDER=anthropic
AKASHA_LLM_API_KEY=sk-xxx
AKASHA_LLM_BASE_URL=https://api.minimaxi.com/anthropic
AKASHA_LLM_MODEL=MiniMax-M2.7

# ── 飞书通道（可选）──
AKASHA_FEISHU_APP_ID=
AKASHA_FEISHU_APP_SECRET=

# ── GitHub Pages 部署（可选）──
AKASHA_SITE_REPO=
